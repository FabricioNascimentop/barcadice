generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model RegistroEtniaSexo {
  Id String @id @default(uuid())

  MunicipioId String
  Municipio   Municipio @relation(fields: [MunicipioId], references: [Id])

  Ano   Int
  Mes   Int
  Etnia Etnia
  Sexo  Sexo
  Valor Int

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  @@unique([MunicipioId, Ano, Mes, Etnia, Sexo])
}

model Municipio {
  Id          String              @id @default(uuid())
  Nome        String              @unique
  Estado      String
  Regiao      String
  indicadores RegistroEtniaSexo[]
}

enum Sexo {
  M
  F
}

enum Etnia {
  Branco
  Preto
  Pardo
  Negro
  Amarelo
  Indigena
  Nao_informado
}
