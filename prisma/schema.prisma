generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}


model Municipio {
  Id                      String                    @id @default(uuid())
  Nome                    String                    @unique
  Estado                  String
  Regiao                  String
  RegistroEtniaSexo       RegistroEtniaSexo[]
  RegistroRenda           RegistroRenda[]
  // Novas relações:
  RegistroTaxas           RegistroTaxas[]
  RegistroTrabalhoInfantil RegistroTrabalhoInfantil[]
}

model RegistroEtniaSexo {
  Id          String    @id @default(uuid())
  MunicipioId String
  Municipio   Municipio @relation(fields: [MunicipioId], references: [Id])
  Ano         Int
  Mes         Int
  Etnia       Etnia
  Sexo        Sexo
  Valor       Int
  CreatedAt   DateTime  @default(now())
  UpdatedAt   DateTime  @updatedAt

  @@unique([MunicipioId, Ano, Mes, Etnia, Sexo])
}

model RegistroRenda {
  Id              String          @id @default(uuid())
  MunicipioId     String
  Municipio       Municipio       @relation(fields: [MunicipioId], references: [Id])
  Ano             Int
  Mes             Int
  Categoria_renda Categoria_renda
  Valor           Float
  CreatedAt       DateTime        @default(now())
  UpdatedAt       DateTime        @updatedAt

  @@unique([MunicipioId, Ano, Mes, Categoria_renda])
  @@index([MunicipioId, Categoria_renda, Ano, Mes])
}


model RegistroTaxas {
  Id          String         @id @default(uuid())
  MunicipioId String
  Municipio   Municipio      @relation(fields: [MunicipioId], references: [Id])
  Ano         Int
  Mes         Int
  Codigo      Int            
  Categoria   CategoriaTaxa
  Valor       Float          
  CreatedAt   DateTime       @default(now())
  UpdatedAt   DateTime       @updatedAt

  @@unique([MunicipioId, Ano, Mes, Categoria])
}

model RegistroTrabalhoInfantil {
  Id          String                   @id @default(uuid())
  MunicipioId String
  Municipio   Municipio                @relation(fields: [MunicipioId], references: [Id])
  Ano         Int
  Mes         Int
  Codigo      Int
  Categoria   CategoriaTrabalhoInfantil
  Valor       Int                      // Usado Int para contagem de famílias
  CreatedAt   DateTime                 @default(now())
  UpdatedAt   DateTime                 @updatedAt

  @@unique([MunicipioId, Ano, Mes, Categoria])
}

// --- ENUMS ---

enum CategoriaTaxa {
  Taxa_acompanhamento_escolar
  Taxa_acompanhamento_saude
  Taxa_att_cadastro
  Fator_1
}

enum CategoriaTrabalhoInfantil {
  Familias_trabalho_infantil
}

enum Categoria_renda {
  Extrema_pobreza
  Pobreza
  Abaixo_meio_salario
  Acima_meio_salario
}

enum Sexo {
  M
  F
}

enum Etnia {
  Branco
  Preto
  Pardo
  Negro
  Amarelo
  Indigena
  Nao_informado
}