generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Municipio {
  Id                       String                     @id @default(uuid())
  Nome                     String                     @unique
  Estado                   String
  Regiao                   String
  RegistroEtniaSexo        RegistroEtniaSexo[]
  RegistroMoradoresRua     RegistroMoradoresRua[]
  RegistroRenda            RegistroRenda[]
  RegistroTaxas            RegistroTaxas[]
  RegistroTrabalhoInfantil RegistroTrabalhoInfantil[]
}

model RegistroEtniaSexo {
  Id          Int       @id @default(autoincrement())
  MunicipioId String
  Ano         Int
  Mes         Int
  Etnia       Etnia
  Sexo        Sexo
  Valor       Int
  Municipio   Municipio @relation(fields: [MunicipioId], references: [Id])

  @@unique([MunicipioId, Ano, Mes, Etnia, Sexo])
}

model RegistroRenda {
  Id              Int             @id @default(autoincrement())
  MunicipioId     String
  Ano             Int
  Mes             Int
  Categoria_renda Categoria_renda
  Valor           Float
  Municipio       Municipio       @relation(fields: [MunicipioId], references: [Id])

  @@unique([MunicipioId, Ano, Mes, Categoria_renda])
  @@index([MunicipioId, Categoria_renda, Ano, Mes])
}

model RegistroTaxas {
  Id          Int           @id @default(autoincrement())
  MunicipioId String
  Ano         Int
  Mes         Int
  Categoria   CategoriaTaxa
  Valor       Float
  Municipio   Municipio     @relation(fields: [MunicipioId], references: [Id])

  @@unique([MunicipioId, Ano, Mes, Categoria])
}

model RegistroTrabalhoInfantil {
  Id          Int                       @id @default(autoincrement())
  MunicipioId String
  Ano         Int
  Mes         Int
  Categoria   CategoriaTrabalhoInfantil
  Valor       Int
  Municipio   Municipio                 @relation(fields: [MunicipioId], references: [Id])

  @@unique([MunicipioId, Ano, Mes, Categoria])
}

model RegistroMoradoresRua {
  Id           Int       @id @default(autoincrement())
  MunicipioId  String
  MoradoresRua Int
  Ano          Int
  Mes          Int
  Municipio    Municipio @relation(fields: [MunicipioId], references: [Id])

  @@unique([MunicipioId, Ano, Mes])
  @@index([MunicipioId, Ano, Mes])
}

enum CategoriaTaxa {
  Taxa_acompanhamento_escolar
  Taxa_acompanhamento_saude
  Taxa_att_cadastro
  Fator_1
}

enum CategoriaTrabalhoInfantil {
  Familias_trabalho_infantil
  Pessoas_trabalho_infantil
}

enum Categoria_renda {
  Extrema_pobreza
  Pobreza
  Abaixo_meio_salario
  Acima_meio_salario
}

enum Sexo {
  M
  F
}

enum Etnia {
  Branco
  Preto
  Pardo
  Negro
  Amarelo
  Indigena
  Nao_informado
}